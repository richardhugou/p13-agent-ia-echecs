# Copier ce fichier en `.env` puis remplir les valeurs manquantes.

# --- Socle (étape 1) ---
API_PORT=8000
CORS_ORIGINS=http://localhost:4200

# --- LLM de synthèse (décision D1 révisée le 22/08 : local, mesuré) ---
# none = gabarit déterministe seul · ollama = qwen3.5:4b local (défaut POC)
# anthropic = option qualité (claude-haiku-4-5, LLM_API_KEY requise)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
LLM_API_KEY=
# Ollama tourne sur la machine hôte (pas dans Docker) : `ollama serve` doit être lancé.
OLLAMA_BASE_URL=http://localhost:11434

# --- Théorie (étape 2) ---
# Jeton personnel Lichess (gratuit) : requis depuis 2026, l'explorer répond 401 sans autorisation.
# À créer sur lichess.org → Préférences → API access tokens (aucun scope particulier).
LICHESS_API_TOKEN=

# --- Moteur & routeur (étape 2) ---
STOCKFISH_DEPTH=16
STOCKFISH_TIME_MS=1000
THEORY_MIN_GAMES=5

# --- RAG (étape 3) — tag Ollama du modèle d'embeddings (mesuré, notebook 02) ---
MILVUS_HOST=milvus
MILVUS_PORT=19530
EMBEDDING_MODEL=qwen3-embedding:0.6b
RAG_TOP_K=5
# Abstention (décision du 26/08 sur données, notebook 07) : 1re défense = règle des
# rayons signés (corpus consulté uniquement dans un rayon établi par la position ou la
# question) ; 2e défense = ce seuil filet de similarité (0.0 = désactivé).
RAG_SCORE_MIN=0.58

# --- Caches & données (étapes 2-4) ---
MONGO_URI=mongodb://mongodb:27017

# --- Vidéos (étape 4) ---
YOUTUBE_API_KEY=

# --- Tracking (optionnel) ---
MLFLOW_TRACKING_URI=http://mlflow:5000
