# Copier ce fichier en `.env` puis remplir les valeurs manquantes.

# --- Socle (étape 1) ---
API_PORT=8000
CORS_ORIGINS=http://localhost:4200

# --- LLM de synthèse (étape 2, décision D1) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
LLM_API_KEY=

# --- Moteur & routeur (étape 2) ---
STOCKFISH_DEPTH=16
STOCKFISH_TIME_MS=1000
THEORY_MIN_GAMES=5

# --- RAG (étape 3) ---
MILVUS_HOST=milvus
MILVUS_PORT=19530
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RAG_TOP_K=5

# --- Caches & données (étapes 2-4) ---
MONGO_URI=mongodb://mongodb:27017

# --- Vidéos (étape 4) ---
YOUTUBE_API_KEY=

# --- Tracking (optionnel) ---
MLFLOW_TRACKING_URI=http://mlflow:5000
